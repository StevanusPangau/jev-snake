# TypeSafe AI Configuration
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
JEV_TIMEOUT_S=1.5

# Daily input-token budget (UTC day). When exhausted, the server transparently
# switches to deterministic fallback mode until the next day. Default: 2000000
# (~$0.084/day at $0.042 per 1M input tokens)
#JEV_DAILY_TOKEN_BUDGET=2000000

# Server Configuration
PORT=8915
DB_PATH=usage.db

# Optional: preserve lifetime telemetry counters from a prior deployment
# (only used when the database is initialized empty)
#JEV_SEED_INPUT_TOKENS=0
#JEV_SEED_OUTPUT_TOKENS=0
#JEV_SEED_REQUESTS=0
