# TypeSafe AI Configuration
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
JEV_TIMEOUT_S=1.5

# Server Configuration
PORT=8915
DB_PATH=usage.db

